# .env.local - Firebase Configuration
# Copy this to .env.local and fill in your Firebase credentials from Firebase Console

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_APP_ID=your_app_id_here

# Instructions:
# 1. Go to Firebase Console (https://console.firebase.google.com)
# 2. Select your project
# 3. Go to Settings (gear icon) > Project Settings
# 4. Scroll to "Your apps" section
# 5. Select your web app or create a new one
# 6. Copy the config and fill in the values above
